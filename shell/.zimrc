# Start configuration added by Zim install {{{
# Use `zimfw install` to refresh added modules.
# This is not sourced during shell startup, and it's only used to configure the
# zimfw plugin manager.
#

#
# Modules
#

# Sets sane Zsh built-in environment options.
zmodule environment
# Provides handy git aliases and functions.
zmodule git
# Applies correct bindkeys for input events.
zmodule input
# Sets a custom terminal title.
zmodule termtitle
# Utility aliases and functions. Adds colour to ls, grep and less.
zmodule utility
# Provides the 'x' or 'extract' command for extracting any archive type
zmodule archive

#
# Prompt
#

# zmodule duration-info
# zmodule git-info  
# zmodule asciiship

#
# Completion
#

# Additional completion definitions for Zsh.
zmodule zsh-users/zsh-completions --fpath src
# Enables and configures smart and extensive tab completion.
# completion must be sourced after all modules that add completion definitions.
# zmodule completion

# Fish-like syntax highlighting for Zsh.
# Load before zsh-autocomplete so it does not try to wrap autocomplete's
# special ZLE widgets such as menu-search and recent-paths.
# zmodule zsh-users/zsh-syntax-highlighting
zmodule zdharma-continuum/fast-syntax-highlighting

zmodule marlonrichert/zsh-autocomplete

#
# Modules that must be initialized last
#
# }}} End configuration added by Zim install
# zmodule agkozak/zsh-z  # Replaced by zoxide, a faster alternative
# zmodule ajeetdsouza/zoxide  
# zsh-autocomplete already provides history menus, recent path completion, and
# completion menu selection. Loading history-substring-search, autosuggestions,
# or fzf-tab with it can wrap the same ZLE widgets and produce startup output.
# zmodule zsh-users/zsh-history-substring-search
# zmodule zsh-users/zsh-autosuggestions
# zmodule Aloxaf/fzf-tab

# Theme - PowerLevel10k
# 使用 PowerLevel10k 主题，功能强大且高度可定制
zmodule romkatv/powerlevel10k --use degit
